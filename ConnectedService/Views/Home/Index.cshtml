@{
    ViewData["Title"] = "Transport Canada AI Agent Services";
}

<style>
    .service-intro {
        max-width: 850px;
        margin-bottom: 2rem;
    }

        .service-intro h1 {
            color: #26374a;
            margin-bottom: 0.75rem;
        }

        .service-intro p {
            font-size: 1.1rem;
            line-height: 1.6;
        }

    .demo-badge {
        display: inline-block;
        margin-bottom: 1rem;
        padding: 0.3rem 0.7rem;
        background: #e5f1f9;
        color: #1c578a;
        font-weight: 600;
        border-radius: 4px;
    }

    .service-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .service-card {
        border: 1px solid #d6d6d6;
        border-top: 5px solid #26374a;
        border-radius: 4px;
        padding: 1.5rem;
        background: #ffffff;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.08);
    }

        .service-card h2 {
            margin-top: 0;
            color: #26374a;
            font-size: 1.3rem;
        }

        .service-card p {
            line-height: 1.5;
            min-height: 72px;
        }

    .service-button {
        display: inline-block;
        margin-top: 0.75rem;
        padding: 0.65rem 1rem;
        background: #26374a;
        color: #ffffff;
        text-decoration: none;
        border-radius: 4px;
        font-weight: 600;
    }

        .service-button:hover {
            background: #1c578a;
            color: #ffffff;
        }
</style>

<section class="service-intro">

    <span class="demo-badge">
        Proof of concept
    </span>

    <h1>Transport Canada AI Agent Services</h1>

    <p>
        Access digital assistants designed to help you find information,
        understand documents and complete common service tasks.
    </p>

</section>

<section class="service-grid"
         aria-label="Available AI Agent services">

    <article class="service-card">
        <h2>Ask an AI Agent</h2>

        <p>
            Ask questions and get help finding information about
            Transport Canada programs and services.
        </p>

        <a href="#" class="service-button">
            Start conversation
        </a>
    </article>

    <article class="service-card">
        <h2>Document Assistant</h2>

        <p>
            Get help understanding documents, requirements and
            information related to your service request.
        </p>

        <a href="#" class="service-button">
            Open assistant
        </a>
    </article>

    <article class="service-card">
        <h2>Application Support</h2>

        <p>
            Get guided assistance with common questions while preparing
            or reviewing an application.
        </p>

        <a href="#" class="service-button">
            Get assistance
        </a>
    </article>

</section>