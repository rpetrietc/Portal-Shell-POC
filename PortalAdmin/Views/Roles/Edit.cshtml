@model PortalAdmin.ViewModels.RoleEditViewModel

@{
    ViewData["Title"] = "Edit Role";
}

<h1>Edit Role</h1>

<p>
    Update the role and its portal link assignments.
</p>

<form asp-action="Edit" method="post">

    @* Keep the role identifier so the correct record is updated. *@
    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label asp-for="Name"
               class="form-label">
        </label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Description"
               class="form-label">
        </label>

        <textarea asp-for="Description"
                  class="form-control"
                  rows="3">
        </textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">
            Portal Links
        </label>

        @foreach (var link in Model.AvailablePortalLinks)
        {
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="SelectedPortalLinkIds"
                       value="@link.Id"
                       id="portal-link-@link.Id"
                       checked="@Model.SelectedPortalLinkIds.Contains(link.Id)" />

                <label class="form-check-label"
                       for="portal-link-@link.Id">
                    @link.Title
                </label>
            </div>
        }
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}