@model PortalAdmin.ViewModels.RoleEditViewModel

@{
    ViewData["Title"] = "Create Role";
}

<h1>Create Role</h1>

<p>
    Create a role and choose the portal links assigned to it.
</p>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <div class="mb-3">
        <label asp-for="Name"
               class="form-label">
        </label>

        <input asp-for="Name"
               class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Description"
               class="form-label">
        </label>

        <textarea asp-for="Description"
                  class="form-control"
                  rows="3">
        </textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">
            Portal Links
        </label>

        @if (Model.AvailablePortalLinks.Count == 0)
        {
            <div class="alert alert-warning">
                No portal links are available.
            </div>
        }
        else
        {
            @foreach (var link in Model.AvailablePortalLinks)
            {
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="SelectedPortalLinkIds"
                           value="@link.Id"
                           id="portal-link-@link.Id"
                           checked="@Model.SelectedPortalLinkIds.Contains(link.Id)" />

                    <label class="form-check-label"
                           for="portal-link-@link.Id">
                        @link.Title
                    </label>
                </div>
            }
        }
    </div>

    <button type="submit"
            class="btn btn-primary">
        Create
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}