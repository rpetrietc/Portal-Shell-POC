@model IEnumerable<PortalData.Models.PortalUser>

@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>

<p>
    This page displays users and their assigned roles.
</p>

<p>
    <a asp-action="Create"
       class="btn btn-primary">
        Create User
    </a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No users have been created yet.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Display Name</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.DisplayName</td>
                    <td>@user.Email</td>

                    <td>
                        @if (user.Roles.Count > 0)
                        {
                            <ul class="mb-0">
                                @foreach (var role in user.Roles
                                                    .OrderBy(role => role.Name))
                                {
                                    <li>@role.Name</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">
                                None assigned
                            </span>
                        }
                    </td>

                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@user.Id"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}