@{
    var pageTitle = ViewData["Title"]?.ToString() ?? "Portal Shell";

    var currentPath = Context.Request.Path;
    var isHome = currentPath == "/";
    var isServiceDemo = currentPath.StartsWithSegments("/ServiceDemo");
    var isDplDemo = currentPath.StartsWithSegments("/DplDemo");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle - Portal Shell</title>

    @* Government of Canada Design System components used
       for the common header, navigation and footer. *@
    <link rel="stylesheet"
          href="https://cdn.design-system.alpha.canada.ca/@@cdssnc/gcds-components@0.43.1/dist/gcds/gcds.css" />

    <script type="module"
            src="https://cdn.design-system.alpha.canada.ca/@@cdssnc/gcds-components@0.43.1/dist/gcds/gcds.esm.js">
    </script>

    <link rel="stylesheet"
          href="https://cdn.design-system.alpha.canada.ca/@@gcds-core/css-shortcuts@1.0.1/dist/gcds-css-shortcuts.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    @* Common Government of Canada header.
       This stays visible while the user moves between portal services. *@
    <gcds-header id="portalHeader"
                 lang-href="#"
                 skip-to-href="#main-content">
    </gcds-header>

    @* Basic portal shell.
       The left side is navigation and the right side is where page/service
       content will be displayed. *@
    <gcds-grid id="portalGrid"
               tag="div"
               container="xl"
               columns="1fr"
               columns-desktop="320px minmax(0, 1fr)"
               gap="400"
               centered>

        <gcds-side-nav id="portalNavigation"
                       label="Portal navigation">

            @if (isHome)
            {
                <gcds-nav-link href="/" current>
                    Home
                </gcds-nav-link>
            }
            else
            {
                <gcds-nav-link href="/">
                    Home
                </gcds-nav-link>
            }

            @if (isServiceDemo)
            {
                <gcds-nav-link href="/ServiceDemo/Embedded" current>
                    Embedded service demo
                </gcds-nav-link>
            }
            else
            {
                <gcds-nav-link href="/ServiceDemo/Embedded">
                    Embedded service demo
                </gcds-nav-link>
            }

            @if (isDplDemo)
            {
                <gcds-nav-link href="/DplDemo/Embedded" current>
                    Digital Personnel Licence
                </gcds-nav-link>
            }
            else
            {
                <gcds-nav-link href="/DplDemo/Embedded">
                    Digital Personnel Licence
                </gcds-nav-link>
            }

            <gcds-nav-link href="https://localhost:7075">
                Connected service
            </gcds-nav-link>

            <gcds-nav-link href="#">
                My applications
            </gcds-nav-link>

            <gcds-nav-link href="#">
                My documents
            </gcds-nav-link>

            <gcds-nav-link href="#">
                Start a service request
            </gcds-nav-link>

        </gcds-side-nav>

        <main id="main-content"
              role="main"
              style="padding-top: 2rem; padding-bottom: 3rem;">

            @RenderBody()

        </main>

    </gcds-grid>

    @* Common Government of Canada footer. *@
    <gcds-footer></gcds-footer>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>