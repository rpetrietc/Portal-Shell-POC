@{
    ViewData["Title"] = "Embedded service";
}

<h1>Embedded service</h1>

<p>
    Select a Civil Aviation regional office to display its location on the map.
</p>

@* Office selector used to update both the embedded map
   and the external map link. *@
<div style="margin-bottom: 1.5rem;">
    <label for="officeSelect">
        <strong>Civil Aviation regional office</strong>
    </label>

    <select id="officeSelect"
            style="display: block; margin-top: 0.5rem; padding: 0.5rem; min-width: 320px;">
        <option value="">Select an office</option>

        <option value="49.282924,-123.122811">
            Pacific Region - Vancouver
        </option>

        <option value="49.89428,-97.14871">
            Prairie and Northern Region - Winnipeg
        </option>

        <option value="43.76335,-79.412895">
            Ontario Region - Toronto
        </option>

        <option value="45.455,-73.750">
            Quebec Region - Dorval
        </option>

        <option value="46.08541,-64.78044">
            Atlantic Region - Moncton
        </option>
    </select>
</div>

@* The container keeps the map's original space in the page
   while the iframe temporarily moves into full-screen focus mode. *@
<div id="mapContainer"
     class="embedded-service-container">

    <iframe id="officeMap"
            class="embedded-service"
            src="https://www.openstreetmap.org/export/embed.html?bbox=-79.50,43.70,-79.32,43.82&layer=mapnik"
            title="Civil Aviation regional office map">
    </iframe>

</div>

@* Provides a visible way to leave full-screen focus mode.
   The Escape key can also be used. *@
<button id="exitFocusMode"
        type="button"
        class="focus-mode-exit"
        hidden>
    Exit focus mode
</button>

@* Opens the currently selected location outside the portal
   so the embedded and external navigation approaches can be compared. *@
<p style="margin-top: 1rem;">
    <a id="openMapLink"
       href="#"
       target="_blank"
       rel="noopener noreferrer">
        Open selected office in a new tab
    </a>
</p>

<script>
    // Get references to the controls used by the map selector.
    const officeSelect = document.getElementById("officeSelect");
    const officeMap = document.getElementById("officeMap");
    const mapContainer = document.getElementById("mapContainer");
    const openMapLink = document.getElementById("openMapLink");

    // Get references to the portal elements used by focus mode.
    const portalHeader = document.getElementById("portalHeader");
    const portalNavigation = document.getElementById("portalNavigation");
    const exitFocusMode = document.getElementById("exitFocusMode");

    // Temporarily prevents focus mode from starting when the dropdown closes
    // and the mouse happens to be positioned over the map.
    let suppressFocusMode = false;

    // Tracks whether the map is currently displayed in focus mode.
    let focusModeActive = false;

    // Update the map whenever a different office is selected.
    officeSelect.addEventListener("change", function () {
        if (!officeSelect.value) {
            return;
        }

        // Prevent the map from entering focus mode immediately
        // after the dropdown selection is made.
        suppressFocusMode = true;

        setTimeout(function () {
            suppressFocusMode = false;
        }, 500);

        const coordinates = officeSelect.value.split(",");
        const latitude = parseFloat(coordinates[0]);
        const longitude = parseFloat(coordinates[1]);

        // Create a small map boundary around the selected location.
        const latitudeOffset = 0.025;
        const longitudeOffset = 0.04;

        const west = longitude - longitudeOffset;
        const south = latitude - latitudeOffset;
        const east = longitude + longitudeOffset;
        const north = latitude + latitudeOffset;

        // Reload the embedded map at the selected office location.
        officeMap.src =
            `https://www.openstreetmap.org/export/embed.html` +
            `?bbox=${west},${south},${east},${north}` +
            `&layer=mapnik` +
            `&marker=${latitude},${longitude}`;

        // Keep the external link pointed at the same selected location.
        openMapLink.href =
            `https://www.openstreetmap.org/` +
            `?mlat=${latitude}&mlon=${longitude}` +
            `#map=14/${latitude}/${longitude}`;
    });

    // Smoothly expand the embedded service from its current position
    // to the full browser content area.
    function enterFocusMode() {
        if (focusModeActive) {
            return;
        }

        focusModeActive = true;

        // Remember the map's current position and size before
        // moving it into the full-screen layer.
        const startPosition = mapContainer.getBoundingClientRect();

        officeMap.style.top = `${startPosition.top}px`;
        officeMap.style.left = `${startPosition.left}px`;
        officeMap.style.width = `${startPosition.width}px`;
        officeMap.style.height = `${startPosition.height}px`;

        officeMap.classList.add("focus-mode");

        // Force the browser to recognize the starting position
        // before beginning the animation.
        void officeMap.offsetWidth;

        document.body.classList.add("focus-mode-active");
        exitFocusMode.hidden = false;

        // Animate the map from its original location to full screen.
        requestAnimationFrame(function () {
            officeMap.style.top = "0";
            officeMap.style.left = "0";
            officeMap.style.width = "100vw";
            officeMap.style.height = "100vh";
        });
    }

    // Smoothly return the embedded service to its original position.
    function leaveFocusMode() {
        if (!focusModeActive) {
            return;
        }

        focusModeActive = false;

        const endPosition = mapContainer.getBoundingClientRect();

        // Bring the surrounding portal layout back while
        // the service shrinks into its original position.
        document.body.classList.remove("focus-mode-active");
        exitFocusMode.hidden = true;

        officeMap.style.top = `${endPosition.top}px`;
        officeMap.style.left = `${endPosition.left}px`;
        officeMap.style.width = `${endPosition.width}px`;
        officeMap.style.height = `${endPosition.height}px`;

        // Wait for the animation to finish before returning
        // the iframe to its normal position in the page.
        setTimeout(function () {
            officeMap.classList.remove("focus-mode");

            officeMap.style.top = "";
            officeMap.style.left = "";
            officeMap.style.width = "";
            officeMap.style.height = "";
        }, 350);
    }

    // Enter focus mode only when the user deliberately moves onto the map.
    officeMap.addEventListener("mouseenter", function () {
        if (!suppressFocusMode && !focusModeActive) {
            enterFocusMode();
        }
    });

    // Allow the user to return to the normal portal layout.
    exitFocusMode.addEventListener("click", leaveFocusMode);

    // Escape provides a keyboard-friendly way to leave focus mode.
    document.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
            leaveFocusMode();
        }
    });
</script>